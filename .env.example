# Copy to .env (gitignored). Never commit real keys.

# Model provider for the lab workloads and the crawler's LLM judge.
# Default: Google AI Studio free tier (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
LAB_PROVIDER=gemini
LAB_GEMINI_MODEL=gemini-2.5-flash
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-flash
# Free tier allows ~10 requests/minute: space lab calls out (seconds).
LAB_MIN_INTERVAL=6.5

# Optional alternative: Anthropic API (LAB_PROVIDER=anthropic, JUDGE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LAB_ANTHROPIC_MODEL=claude-haiku-5-5

# What the simulated Bedrock route records in CloudTrail / invocation logs
SIMULATED_BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5

# Fake AWS (moto) + trace backend
AWS_ENDPOINT_URL=http://localhost:5000
AWS_ACCESS_KEY_ID=testing
AWS_SECRET_ACCESS_KEY=testing
AWS_DEFAULT_REGION=us-east-1
OTLP_ENDPOINT=http://localhost:4318
JAEGER_URL=http://localhost:16686

# Copy to .env (gitignored). Never commit real keys.

# Model provider for the lab workloads and the crawler's LLM judge.
# Default: Google AI Studio free tier (https://aistudio.google.com/apikey).
GEMINI_API_KEY=
LAB_PROVIDER=gemini
# Several models, comma-separated: when one runs out of free daily quota (~20
# requests per model) or is overloaded, the lab moves on to the next.
LAB_GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.1-flash-lite
# Free tier allows ~10 requests/minute: space lab calls out (seconds).
LAB_MIN_INTERVAL=6.5
# Run each agent on one request instead of three, to fit the free tier's daily cap.
# One request is enough to show a tool loop. Leave empty to run every event.
LAB_MAX_AGENT_EVENTS=1

# Optional alternative: Anthropic API (LAB_PROVIDER=anthropic, JUDGE_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
LAB_ANTHROPIC_MODEL=claude-haiku-5-5

# What the simulated Bedrock route records in CloudTrail / invocation logs
SIMULATED_BEDROCK_MODEL_ID=anthropic.claude-haiku-5-5

# Fake AWS (Floci, docker-compose) + trace backend + store
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
OTLP_ENDPOINT=http://localhost:4318
JAEGER_URL=http://localhost:16686
AGENTSCAN_DB=postgresql://agentscan:agentscan@localhost:5433/agentscan
